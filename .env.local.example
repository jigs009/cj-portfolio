# Environment variables — copy to .env.local and fill in

# Form endpoint (Formspree recommended)
# 1. Create a free account at https://formspree.io
# 2. Create a form, copy the endpoint URL
# 3. Paste it here
NEXT_PUBLIC_FORM_ENDPOINT=

# Analytics (optional)
# Set provider to "plausible" or "ga"
NEXT_PUBLIC_ANALYTICS_TYPE=
NEXT_PUBLIC_ANALYTICS_ID=

# Your production domain (used for sitemap and OG tags)
NEXT_PUBLIC_SITE_URL=https://yourdomain.com
